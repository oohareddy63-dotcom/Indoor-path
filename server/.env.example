# Copy this file to .env and fill in your values
# Never commit .env to version control

# MongoDB Atlas connection string (direct shard URI)
MONGODB_URI=mongodb://<db_username>:<db_password>@<shard-00>.mongodb.net:27017,<shard-01>.mongodb.net:27017,<shard-02>.mongodb.net:27017/?ssl=true&authSource=admin&appName=<cluster-name>

# Express API port (default: 3001)
API_PORT=3001
